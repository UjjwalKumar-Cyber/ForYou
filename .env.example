NODE_ENV=development
PORT=3000

# Change these before sharing or deploying.
MESSAGE_PAGE_PASSWORD=change-this-secret-page-password
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_SECRET=replace-with-a-long-random-session-secret

# Optional extra inbox accounts. Format: username:password,anotheruser:anotherpassword
ACCOUNT_USERS=

# Optional. Render persistent disks commonly mount at /var/data.
DATA_DIR=data

# Optional. If set, the app stores messages in Postgres instead of JSON.
DATABASE_URL=
