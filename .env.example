NODE_ENV=development
PORT=3000
SERVICE_DISCONTINUED=true
ENABLE_DISCONTINUED_MODE=true

# Change these before sharing or deploying.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_TABLE=foryou_sessions

# Optional. Keep false to hide /secret-8392-love-note and use /admin as the main login.
ENABLE_SECRET_PAGE=false
MESSAGE_PAGE_PASSWORD=change-this-only-if-secret-page-is-enabled

# Optional extra inbox accounts. Format: username:password,anotheruser:anotherpassword
ACCOUNT_USERS=

# Optional. Render persistent disks commonly mount at /var/data.
DATA_DIR=data

# Optional local backup folder. Production uses temporary storage unless Cloudinary is configured.
BACKUP_DIR=/Users/ujjwalkumar/Downloads/FORYOU_BACKUP

# Optional. If set, the app stores messages in Postgres instead of JSON.
DATABASE_URL=

# Optional. Store profile pictures and message media in Cloudinary instead of large DB blobs.
# Either set CLOUDINARY_URL or the three individual Cloudinary values.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional performance/analytics settings.
ANALYTICS_RETENTION_DAYS=30
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_POOL_MAX_USES=7500
